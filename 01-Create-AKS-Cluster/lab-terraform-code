resource "azurerm_resource_group" "aks-rg" {
  name     = "aks-rg1"
  location = "Central US"
}

resource "azurerm_kubernetes_cluster" "aks-lab" {
  name                = "aksdemo1"
  location            = azurerm_resource_group.aks-rg.location
  resource_group_name = azurerm_resource_group.aks-rg.name
  dns_prefix          = "aksdemo1"

  default_node_pool {
    name           = "default"
    min_count      = 1
    max_count      = 5
    enable_auto_scaling = true
    vm_size        = "Standard_DS2_v2"

  }

  identity {
    type = "SystemAssigned"
  }


  sku_tier = "Free"
}

output "client_certificate" {
  value     = azurerm_kubernetes_cluster.aks-lab.kube_config[0].client_certificate
  sensitive = true
}

output "kube_config" {
  value     = azurerm_kubernetes_cluster.aks-lab.kube_config_raw
  sensitive = true
}
